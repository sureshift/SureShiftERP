# ═══════════════════════════════════════════════════════════════════════════
#  SureShift + Freight It — Environment Template
#  Copy to .env and fill in real values
#  Run: cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════════════════════

# ───────── DOMAINS ──────────────────────────────────────────────────────────
N8N_HOST=automation.freightit.in
EVO_HOST=api.freightit.in
PB_FREIGHTIT_HOST=pb.freightit.in
PB_SURESHIFT_HOST=pb.sureshift.in
POSTIZ_HOST=social.freightit.in
SURESHIFT_ERP_HOST=erp.sureshift.in

# ───────── DATABASE (Postgres) ──────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_db_password
POSTGRES_DB=freight_db

# ───────── REDIS ────────────────────────────────────────────────────────────
REDIS_URI=redis://redis:6379

# ───────── EVOLUTION GO ─────────────────────────────────────────────────────
AUTHENTICATION_API_KEY=your_evolution_api_key

# ───────── N8N ──────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=your_n8n_encryption_key
WEBHOOK_URL=https://automation.freightit.in/
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_MAX_AGE=24
N8N_EXECUTIONS_PROCESS=main

# ───────── POSTIZ ───────────────────────────────────────────────────────────
POSTIZ_SECRET=your_postiz_jwt_secret

# ───────── FACEBOOK / INSTAGRAM / THREADS ───────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret

# ───────── LINKEDIN ─────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ───────── CLOUDFLARE ───────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# ───────── SURESHIFT ERP ────────────────────────────────────────────────────
PB_SURESHIFT_ADMIN_EMAIL=admin@sureshift.in
PB_SURESHIFT_ADMIN_PASS=YourStrongAdminPassword@2026
# Generate with: openssl rand -hex 32
PB_ENCRYPTION_KEY=your_32_char_hex_encryption_key
